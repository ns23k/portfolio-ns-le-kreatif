# ============================================================
#  Ns_le Kréatif — configuration (copier en .env et remplir)
# ============================================================

# --- Base de données TiDB Cloud (compatible MySQL) ---
# Option A : une seule URL (TiDB Cloud > Connect > "General" > copier la chaîne)
# DATABASE_URL=mysql://USER:MOT_DE_PASSE@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/nslekreatif

# Option B : champs séparés
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=change-moi
DB_NAME=nslekreatif
# TiDB Cloud exige TLS : laisser à true (mettre false seulement pour un MySQL local)
DB_SSL=true

# --- Espace administrateur ---
ADMIN_USER=admin
ADMIN_PASSWORD=un-mot-de-passe-long-et-unique
# Chaîne aléatoire longue (au moins 32 caractères) pour signer les sessions
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# --- Adresse publique du site (utilisée dans les emails) ---
SITE_URL=https://ns-le-kreatif.vercel.app

# --- Emails automatiques (optionnel) ---
# Sans ces variables, tout fonctionne : tu réponds via les boutons Email / WhatsApp de l'admin.
# Avec Gmail : activer la validation en 2 étapes puis créer un "mot de passe d'application".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ns_le Kréatif <etudeetudiant123@gmail.com>"
# Où recevoir les notifications de nouvelles demandes
ADMIN_NOTIFY_EMAIL=etudeetudiant123@gmail.com

PORT=3000
